---
layout: base.njk
---
<section class="hero" id="top">
  <div class="hero__inner">
    <p class="eyebrow">Assistant &amp;<br class="br-mobile"> VFX Editor</p>
    <h1 class="hero__title">Hi, I'm Sam.</h1>
    <p class="hero__lead">I work on feature films, series and commercials, keeping media, VFX and turnovers in order from dailies to delivery.</p>
  </div>
</section>

<section class="credits" id="credits" aria-labelledby="credits-title">
  <h2 class="section-label" id="credits-title">Credits</h2>
  <ul class="grid" role="list">
  {%- for p in projects.projects %}
    <li class="credit">
      {%- if p.link %}<a class="credit__link" href="{{ p.link }}" target="_blank" rel="noopener">{% else %}<div class="credit__link">{% endif %}
        <div class="tile{% if not p.poster %} tile--empty{% endif %}">
          {%- if p.poster %}{% poster p.poster, p.title + " poster" %}{% else %}<span class="tile__card" aria-hidden="true"><span class="tile__client">{{ p.client }}</span><span class="tile__title">{{ p.title }}</span><span class="tile__year">{{ p.year }}</span></span>{% endif %}
          {%- if p.status %}<span class="badge">In post</span>{% endif %}
        </div>
        <div class="credit__meta">
          <span class="credit__role">{{ p.role | ampBreak | safe }}</span>
          <span class="credit__title">{{ p.title }}</span>
          <span class="credit__info">{{ p.client }} · {{ p.year }}{% if p.status %}<span class="visually-hidden"> · {{ p.status }}</span>{% endif %}</span>
        </div>
      {% if p.link %}</a>{% else %}</div>{% endif %}
    </li>
  {%- endfor %}
  </ul>
</section>

<section class="contact" id="contact" aria-labelledby="contact-title">
  <h2 class="contact__title" id="contact-title">Let's work together.</h2>
  <p class="contact__lead">Looking for an assistant or VFX editor for your next project?<br> Drop me a line.</p>
  <a class="button js-mail" href="#contact" data-user="{{ site.mailUser }}" data-domain="{{ site.mailDomain }}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
    Write an email
  </a>
  <noscript><p class="contact__fallback">{{ site.mailUser }} [at] {{ site.mailDomain }}</p></noscript>
</section>
